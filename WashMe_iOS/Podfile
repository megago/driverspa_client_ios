source 'https://cdn.cocoapods.org/'
platform :ios, "14.0"

target "WashMe" do
  pod 'Reachability', '3.2'
  pod 'MBProgressHUD', '~> 0.9.2'
  pod 'SDWebImage', '3.7.5'
  pod 'FrameAccessor', '2.0'
  pod 'CRGradientNavigationBar'
  pod 'AFNetworking', '~> 2.6.0'
  pod 'TPKeyboardAvoiding', '1.3'
  pod 'BSKeyboardControls'
  pod 'INTULocationManager', '4.2.0'
  pod 'UIActionSheet+Blocks', '0.9'
  pod 'UIAlertView+Blocks', '0.9'
  pod 'AMRatingControl'
  pod 'TMCache', '2.1.0'
  # pod 'PINCache'
  pod 'SDSegmentedControl', '1.0.4'
  pod 'SDiPhoneVersion', '1.1.2'
  pod 'SSKeychain', '1.4.0'
  pod 'M13BadgeView', '1.0.4'
  pod 'MWPhotoBrowser', '1.4.1'
  pod 'GoogleMaps', '~> 8.4'
  pod 'DateTools', '1.7.0'
  pod 'REMenu', '~> 1.10'
  pod 'ObjectiveSugar', '1.1.0'
  pod 'ConcisePureLayout', '= 0.3.1'
  # IQKeyboardManager removed: v4.0.1 (2016) crashes on iOS 18+ ("circumvented Objective-C runtime
  # dealloc initiation for <UIImageView>") by corrupting the system predictive-text bar when a field
  # becomes first responder — even with setEnable:NO. Keyboard handling is covered by
  # TPKeyboardAvoiding + BSKeyboardControls. Re-add a modern IQKeyboardManager (6.x+) if needed.
  pod 'SVProgressHUD', '1.1.3'
  pod 'REFrostedViewController', '2.4.8'
  pod 'ChameleonFramework', '2.1.0'
  pod 'DZNEmptyDataSet', '1.7.3'
  pod 'UIScrollView-InfiniteScroll'
  pod 'EAIntroView', '~> 2.9.0'
  pod 'LGRefreshView', '~> 1.0.0'
  pod 'HTHorizontalSelectionList', '~> 0.7.3'
  #pod 'OneSignal', '~> 2.0.0'
  pod 'HMSegmentedControl'
  # Crashlytics + Fabric removed: Fabric was shut down in 2020, and both shipped only as
  # device-arm64 fat frameworks (no arm64-simulator slice), which forced the whole app to the
  # x86_64 simulator under Rosetta on Apple Silicon and crashed with the UIKit objc
  # "circumvented dealloc initiation" assertion. Re-add via FirebaseCrashlytics if/when needed.
end

# BSKeyboardControls (last released 2013) builds its prev/next toolbar buttons with
# UIBarButtonSystemItem values 105/106. Those are not valid system items on modern iOS
# and -[UIBarButtonItem initWithBarButtonSystemItem:] throws NSInvalidArgumentException
# ("Unsupported UIBarButtonSystemItem value: 105"), crashing any screen that installs a
# keyboard-control accessory view. Replace them with valid title-based buttons.
post_install do |installer|
  bs_file = File.join(installer.sandbox.root, 'BSKeyboardControls', 'BSKeyboardControls', 'BSKeyboardControls.m')
  if File.exist?(bs_file)
    File.chmod(0644, bs_file) # pod sources install read-only; make writable before patching
    text = File.read(bs_file)
    text.gsub!('initWithBarButtonSystemItem:105 target:self action:@selector(selectPreviousField)',
               'initWithTitle:@"❮" style:UIBarButtonItemStylePlain target:self action:@selector(selectPreviousField)')
    text.gsub!('initWithBarButtonSystemItem:106 target:self action:@selector(selectNextField)',
               'initWithTitle:@"❯" style:UIBarButtonItemStylePlain target:self action:@selector(selectNextField)')
    File.write(bs_file, text)
  end

  # Several old pods (Reachability 3.2, AFNetworking 2.6) import the private SDK header
  # <netinet6/in6.h>; current Xcode rejects it ("Use of private header from outside its module").
  # It is redundant — <netinet/in.h> already provides the IPv6 declarations — so strip it everywhere.
  Dir.glob(File.join(installer.sandbox.root, '**', '*.m')).each do |m_file|
    text = File.read(m_file)
    next unless text.include?('<netinet6/in6.h>')
    File.chmod(0644, m_file)
    File.write(m_file, text.gsub(/^#import <netinet6\/in6\.h>\n/, ''))
  end

  # Many of these pods are old and declare an iOS 7/8 minimum, which current Xcode rejects.
  # Pin every pod target to the app's minimum and let CocoaPods pick the simulator arch.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      config.build_settings.delete('VALID_ARCHS')
    end
  end
end
